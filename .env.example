# Copy this file to .env before starting the stack:
#   copy .env.example .env
#
# These values are for local Docker development only.
# Change POSTGRES_PASSWORD before using this project anywhere else.

POSTGRES_USER=bms_user
POSTGRES_PASSWORD=bms_dev_password
POSTGRES_DB=bms
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=5173

NODE_ENV=development

# docker-compose.yml builds these for the backend container:
# DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
# FRONTEND_URL=http://localhost:FRONTEND_PORT
# Prisma reads DATABASE_URL from the environment. Do not hardcode it.
# FRONTEND_URL is the only browser origin allowed to call the API.
# Production must set FRONTEND_URL. It is never "*".

# Development-only JWT secrets. Replace both before any shared or production deployment.
JWT_ACCESS_SECRET=dev-only-access-secret-change-before-production
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-before-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Shared password for the five seeded development users.
# DEVELOPMENT ONLY. Change this before production. The seed refuses the default in production.
SEED_DEFAULT_PASSWORD=ChangeMe-Dev-Only-1

# Authentication rate limit. 100 requests per 15 minutes is the local default.
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Estimated energy cost. This is not a utility bill. The API reads these values.
# Do not copy them into VITE_ variables.
ENERGY_COST_PER_KWH=0.25
CURRENCY_CODE=USD
# Optional daily consumption target in kWh. Leave empty when no target is configured.
ENERGY_DAILY_TARGET_KWH=

# Compose gives the frontend VITE_API_URL=http://localhost:BACKEND_PORT/api/v1.
# The browser uses that host address. Do not point it at the Docker hostname "backend".
# VITE_ variables are public in the browser. Do not put secrets there.
